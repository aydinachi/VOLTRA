          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "professorIds": {
          "type": "array",
          "description": "Bounded list (max 10) of assigned professor UIDs."
        },
        "professorNames": {
          "type": "array",
          "description": "Optional bounded list (1 to 10, max 100 chars) of professor display names on the course."
        },
        "assistantNames": {
          "type": "array",
          "description": "Optional bounded list (0 to 15, max 100 chars) of teaching assistant display names on the course."
        },
        "studyProgram": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Optional study program (Stručni studij · Razvoj softvera (2 godine), Bachelor, or Master department)."
        },
        "categoryIds": {
          "type": "array",
          "description": "Bounded list (max 20) of grading category IDs."
        },
        "itemIds": {
          "type": "array",
          "description": "Bounded list (max 60) of grading item IDs."
        },
        "sessionIds": {
          "type": "array",
          "description": "Bounded list (max 60) of attendance session IDs."
        },
        "examTermIds": {
          "type": "array",
          "description": "Optional bounded list (max 40) of published exam term IDs."
        },
        "scheduleEventIds": {
          "type": "array",
          "description": "Optional bounded list (max 80) of course schedule event IDs."
        },
        "isArchived": {
          "type": "boolean",
          "description": "Optional archive flag marking completed past-semester courses."
        },
        "attendanceEnabled": {
          "type": "boolean"
        },
        "attendanceMaxPoints": {
          "type": "number"
        },
        "allowBonusPoints": {
          "type": "boolean"
        },
        "activityMarksEnabled": {
          "type": "boolean",
          "description": "Optional flag indicating whether this course uses plus (+) / activity marks for exercises and optional activity points."
        },
        "grade6Threshold": {
          "type": "number"
        },
        "grade7Threshold": {
          "type": "number"
        },
        "grade8Threshold": {
          "type": "number"
        },
        "grade9Threshold": {
          "type": "number"
        },
        "grade10Threshold": {
          "type": "number"
        },
        "isSeed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "name",
        "semester",
        "academicYear",
        "ects",
        "leadProfessorId",
        "leadProfessorName",
        "professorIds",
