          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "targetEmail",
        "fullName",
        "role",
        "studentIndex",
        "department",
        "studyTrack",
        "studyYear",
        "academicYear",
        "academicTitle",
        "officeLocation",
        "consultationHours",
        "authUid",
        "status",
