{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "System administrator privilege record keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the bootstrap administrator who granted access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "grantedBy", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public academic identity profile without PII. Faculty-assigned fields are locked for students.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique user identifier."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full display name of student, professor, or administrator."
        },
        "studentIndex": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "ETF student index number (broj indeksa), faculty-assigned for students."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "ETF Sarajevo department (odsjek)."
        },
        "role": {
          "type": "string",
          "enum": ["student", "professor", "admin"],
          "description": "Assigned portal role."
        },
        "academicYear": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Active academic year, e.g. 2026/2027."
        },
        "redeemedInviteId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Invitation or provisioning ID redeemed on registration, or empty string."
        },
        "academicTitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Optional academic title for professors (e.g. vanr. prof. dr., doc. dr.)."
        },
        "officeLocation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60,
          "description": "Optional faculty office location (kabinet) for professors."
        },
        "consultationHours": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Optional consultation schedule for professors."
        },
        "studyYear": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Optional faculty-assigned study year and cycle for students."
        },
        "studyTrack": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Optional faculty-assigned study program (Stručni RS, Bachelor, or Master department)."
        },
        "personalNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Optional personal bio or status note editable by the user."
        },
        "provisionedByAdmin": {
          "type": "boolean",
          "description": "System flag set strictly by Administrator when provisioning Email/Password accounts."
        },
        "notificationPrefs": {
          "type": "object",
          "description": "Smart notification boolean toggles chosen by the student."
        },
        "isSeed": {
          "type": "boolean",
          "description": "Marks development seed data separately from production records."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "fullName",
        "studentIndex",
        "department",
        "role",
        "academicYear",
        "redeemedInviteId",
        "isSeed",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated private PII data (email and optional phone) accessible only to the owner and administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Private email address."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30,
          "description": "Optional private contact phone number editable by owner or admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
