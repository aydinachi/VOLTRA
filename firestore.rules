rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Primitive Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCourseId(id) {
      return id is string && id.size() >= 1 && id.size() <= 60 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStudentId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aydinachi@gmail.com' ||
        request.auth.token.email == 'samir.admin@etf.unsa.ba'
      );
    }

    function hasAdminDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAdminRoleProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminProvisionedUser() {
      return isSignedIn() && (
        hasAdminDoc() ||
        hasAdminRoleProfile() ||
        (
          exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role in ['professor', 'admin'] ||
            (
              'provisionedByAdmin' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data &&
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.provisionedByAdmin == true
            )
          )
        )
      );
    }

    function isAuthorizedUser() {
      return isSignedIn();
    }

    function isAdmin() {
      return isBootstrapAdmin() || hasAdminDoc() || hasAdminRoleProfile();
    }

    function isProfessorUser() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.email == 'sribic@etf.unsa.ba' ||
        request.auth.token.email == 'samir.admin@etf.unsa.ba' ||
        (
          exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role in ['professor', 'admin']
        )
      );
    }

    function isCourseHolder(courseId) {
      return isSignedIn() && (
        isAdmin() ||
        isProfessorUser() ||
        (
          exists(/databases/$(database)/documents/courses/$(courseId)) && (
            get(/databases/$(database)/documents/courses/$(courseId)).data.leadProfessorId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.professorIds
          )
        )
      );
    }

    function isCourseProfessor(courseId) {
      return isSignedIn() && (
        isAdmin() ||
        isProfessorUser() ||
        (
          exists(/databases/$(database)/documents/courses/$(courseId)) && (
            get(/databases/$(database)/documents/courses/$(courseId)).data.leadProfessorId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.professorIds
          )
        )
      );
    }

    function isEnrolledStudent(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid));
    }

    function isValidBoundedIdList(arr, minLen, maxLen) {
      return arr is list &&
        arr.size() >= minLen &&
        arr.size() <= maxLen &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 128));
    }

    function isValidBoundedStringList(arr, minLen, maxLen, maxItemLen) {
      return arr is list &&
        arr.size() >= minLen &&
        arr.size() <= maxLen &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= maxItemLen));
    }

    function isValidNotificationPrefs(prefs) {
      return prefs is map &&
        prefs.keys().hasAll([
          'resultsPublished', 'pointsChanged', 'attendanceRecorded', 'newExamTerm', 'announcements'
        ]) &&
        prefs.keys().hasOnly([
          'resultsPublished', 'pointsChanged', 'attendanceRecorded', 'newExamTerm', 'announcements'
        ]) &&
        prefs.resultsPublished is bool &&
        prefs.pointsChanged is bool &&
        prefs.attendanceRecorded is bool &&
        prefs.newExamTerm is bool &&
        prefs.announcements is bool;
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.grantedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'fullName', 'studentIndex', 'department', 'role',
          'academicYear', 'redeemedInviteId', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'fullName', 'studentIndex', 'department', 'role',
          'academicYear', 'redeemedInviteId',
          'academicTitle', 'officeLocation', 'consultationHours', 'studyYear', 'studyTrack',
          'personalNote', 'provisionedByAdmin', 'notificationPrefs',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.studentIndex is string && data.studentIndex.size() <= 20 && data.studentIndex.matches('^[a-zA-Z0-9_\\-]*$') &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
        data.role is string && data.role in ['student', 'professor', 'admin'] &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 20 &&
        data.redeemedInviteId is string && data.redeemedInviteId.size() <= 128 &&
        (!('academicTitle' in data) || (data.academicTitle is string && data.academicTitle.size() <= 40)) &&
        (!('officeLocation' in data) || (data.officeLocation is string && data.officeLocation.size() <= 60)) &&
        (!('consultationHours' in data) || (data.consultationHours is string && data.consultationHours.size() <= 100)) &&
        (!('studyYear' in data) || (data.studyYear is string && data.studyYear.size() <= 80)) &&
        (!('studyTrack' in data) || (data.studyTrack is string && data.studyTrack.size() <= 100)) &&
        (!('personalNote' in data) || (data.personalNote is string && data.personalNote.size() <= 240)) &&
        (!('provisionedByAdmin' in data) || data.provisionedByAdmin is bool) &&
        (!('notificationPrefs' in data) || isValidNotificationPrefs(data.notificationPrefs)) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProvisionedAccount(data) {
      return data.keys().hasAll([
          'targetEmail', 'fullName', 'role', 'studentIndex', 'department',
          'studyTrack', 'studyYear', 'academicYear',
          'academicTitle', 'officeLocation', 'consultationHours',
          'authUid', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'targetEmail', 'fullName', 'role', 'studentIndex', 'department',
          'studyTrack', 'studyYear', 'academicYear',
          'academicTitle', 'officeLocation', 'consultationHours',
          'authUid', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.targetEmail is string && data.targetEmail.size() >= 3 && data.targetEmail.size() <= 254 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.role is string && data.role in ['student', 'professor', 'admin'] &&
        data.studentIndex is string && data.studentIndex.size() <= 20 && data.studentIndex.matches('^[a-zA-Z0-9_\\-]*$') &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
        data.studyTrack is string && data.studyTrack.size() <= 100 &&
        data.studyYear is string && data.studyYear.size() <= 80 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 20 &&
        data.academicTitle is string && data.academicTitle.size() <= 40 &&
        data.officeLocation is string && data.officeLocation.size() <= 60 &&
        data.consultationHours is string && data.consultationHours.size() <= 100 &&
        data.authUid is string && data.authUid.size() <= 128 &&
        data.status is string && data.status in ['active', 'pending', 'claimed'] &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentDirectory(data) {
      return data.keys().hasAll([
          'studentIndex', 'uid', 'fullName', 'department', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentIndex', 'uid', 'fullName', 'department', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.studentIndex is string && data.studentIndex.size() >= 1 && data.studentIndex.size() <= 20 && data.studentIndex.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.uid) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvitation(data) {
      return data.keys().hasAll([
          'code', 'targetEmail', 'role', 'status', 'createdBy', 'acceptedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'targetEmail', 'role', 'status', 'createdBy', 'acceptedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() >= 6 && data.code.size() <= 64 && data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.targetEmail is string && data.targetEmail.size() >= 3 && data.targetEmail.size() <= 254 &&
        data.role is string && data.role in ['professor'] &&
        data.status is string && data.status in ['pending', 'accepted', 'revoked'] &&
        isValidId(data.createdBy) &&
        data.acceptedBy is string && data.acceptedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCourse(data) {
      return data.keys().hasAll([
          'code', 'name', 'semester', 'academicYear', 'ects',
          'leadProfessorId', 'leadProfessorName', 'professorIds',
          'categoryIds', 'itemIds', 'sessionIds',
          'attendanceEnabled', 'attendanceMaxPoints', 'allowBonusPoints',
          'grade6Threshold', 'grade7Threshold', 'grade8Threshold', 'grade9Threshold', 'grade10Threshold',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'name', 'semester', 'academicYear', 'ects',
          'leadProfessorId', 'leadProfessorName', 'professorIds',
          'professorNames', 'assistantNames', 'studyProgram',
          'categoryIds', 'itemIds', 'sessionIds', 'examTermIds', 'scheduleEventIds',
          'isArchived',
          'attendanceEnabled', 'attendanceMaxPoints', 'allowBonusPoints', 'activityMarksEnabled',
          'grade6Threshold', 'grade7Threshold', 'grade8Threshold', 'grade9Threshold', 'grade10Threshold',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 20 && data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 80 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 20 &&
        data.ects is number && data.ects >= 1 && data.ects <= 30 &&
        isValidId(data.leadProfessorId) &&
        data.leadProfessorName is string && data.leadProfessorName.size() >= 1 && data.leadProfessorName.size() <= 100 &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        (!('professorNames' in data) || data.professorNames == null || isValidBoundedStringList(data.professorNames, 0, 10, 100)) &&
        (!('assistantNames' in data) || data.assistantNames == null || isValidBoundedStringList(data.assistantNames, 0, 15, 100)) &&
        (!('studyProgram' in data) || data.studyProgram == null || (data.studyProgram is string && data.studyProgram.size() <= 100)) &&
        isValidBoundedIdList(data.categoryIds, 0, 20) &&
        isValidBoundedIdList(data.itemIds, 0, 60) &&
        isValidBoundedIdList(data.sessionIds, 0, 60) &&
        (!('examTermIds' in data) || data.examTermIds == null || isValidBoundedIdList(data.examTermIds, 0, 40)) &&
        (!('scheduleEventIds' in data) || data.scheduleEventIds == null || isValidBoundedIdList(data.scheduleEventIds, 0, 80)) &&
        (!('isArchived' in data) || data.isArchived == null || data.isArchived is bool) &&
        data.attendanceEnabled is bool &&
        data.attendanceMaxPoints is number && data.attendanceMaxPoints >= 0 && data.attendanceMaxPoints <= 100 &&
        data.allowBonusPoints is bool &&
        (!('activityMarksEnabled' in data) || data.activityMarksEnabled == null || data.activityMarksEnabled is bool) &&
        data.grade6Threshold is number && data.grade6Threshold >= 0 &&
        data.grade7Threshold is number && data.grade7Threshold > data.grade6Threshold &&
        data.grade8Threshold is number && data.grade8Threshold > data.grade7Threshold &&
        data.grade9Threshold is number && data.grade9Threshold > data.grade8Threshold &&
        data.grade10Threshold is number && data.grade10Threshold > data.grade9Threshold && data.grade10Threshold <= 200 &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll([
          'courseId', 'courseCode', 'courseName', 'leadProfessorName', 'academicYear',
          'studentId', 'studentName', 'studentIndex', 'studentDepartment',
          'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'courseCode', 'courseName', 'leadProfessorName', 'academicYear',
          'semester', 'isArchived',
          'studentId', 'studentName', 'studentIndex', 'studentDepartment',
          'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 20 &&
        data.courseName is string && data.courseName.size() >= 1 && data.courseName.size() <= 120 &&
        data.leadProfessorName is string && data.leadProfessorName.size() >= 1 && data.leadProfessorName.size() <= 100 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 20 &&
        (!('semester' in data) || (data.semester is string && data.semester.size() <= 80)) &&
        (!('isArchived' in data) || data.isArchived is bool) &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 64 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.studentIndex is string && data.studentIndex.size() >= 1 && data.studentIndex.size() <= 20 &&
        data.studentDepartment is string && data.studentDepartment.size() >= 1 && data.studentDepartment.size() <= 80 &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGradingCategory(data) {
      return data.keys().hasAll([
          'courseId', 'name', 'maxPoints', 'order', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'name', 'maxPoints', 'order', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.maxPoints is number && data.maxPoints >= 0 && data.maxPoints <= 100 &&
        data.order is number && data.order >= 0 && data.order <= 50 &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGradingItem(data) {
      return data.keys().hasAll([
          'courseId', 'categoryId', 'name', 'maxPoints', 'date', 'description',
          'order', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'categoryId', 'name', 'maxPoints', 'date', 'description',
          'order', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 && data.categoryId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.maxPoints is number && data.maxPoints > 0 && data.maxPoints <= 100 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.description is string && data.description.size() <= 500 &&
        data.order is number && data.order >= 0 && data.order <= 200 &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidScore(data) {
      return data.keys().hasAll([
          'courseId', 'categoryId', 'itemId', 'studentId', 'points', 'feedback',
          'gradedBy', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'categoryId', 'itemId', 'studentId', 'points', 'feedback',
          'gradedBy', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 && data.categoryId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 60 && data.itemId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 64 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.points is number && data.points >= 0 && data.points <= 200 &&
        data.feedback is string && data.feedback.size() <= 500 &&
        isValidId(data.gradedBy) &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidScoreWithinMax(data) {
      return exists(/databases/$(database)/documents/gradingItems/$(data.itemId)) &&
        exists(/databases/$(database)/documents/enrollments/$(data.courseId + '_' + data.studentId)) &&
        get(/databases/$(database)/documents/gradingItems/$(data.itemId)).data.courseId == data.courseId && (
          data.points <= get(/databases/$(database)/documents/gradingItems/$(data.itemId)).data.maxPoints ||
          get(/databases/$(database)/documents/courses/$(data.courseId)).data.allowBonusPoints == true
        );
    }

    function isValidAttendanceSession(data) {
      return data.keys().hasAll([
          'courseId', 'date', 'time', 'topic', 'isCancelled', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'date', 'time', 'topic', 'isCancelled', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() <= 20 &&
        data.topic is string && data.topic.size() <= 150 &&
        data.isCancelled is bool &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
          'courseId', 'sessionId', 'studentId', 'present', 'note', 'markedBy', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'sessionId', 'studentId', 'present', 'note', 'markedBy', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 60 && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 64 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.present is bool &&
        data.note is string && data.note.size() <= 200 &&
        isValidId(data.markedBy) &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFinalGrade(data) {
      return data.keys().hasAll([
          'courseId', 'studentId', 'totalPoints', 'finalGrade', 'status',
          'finalizedBy', 'comment', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'studentId', 'totalPoints', 'finalGrade', 'status',
          'finalizedBy', 'comment', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 64 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.totalPoints is number && data.totalPoints >= 0 && data.totalPoints <= 200 &&
        data.finalGrade is number && data.finalGrade >= 5 && data.finalGrade <= 10 &&
        data.status is string && data.status in ['draft', 'finalized'] &&
        isValidId(data.finalizedBy) &&
        data.comment is string && data.comment.size() <= 300 &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExamTerm(data) {
      return data.keys().hasAll([
          'courseId', 'courseCode', 'courseName', 'title',
          'examDate', 'examTime', 'classroom',
          'registrationOpenDate', 'registrationCloseDate',
          'notes', 'isOpen', 'createdBy', 'professorIds',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'courseCode', 'courseName', 'title',
          'examDate', 'examTime', 'classroom',
          'registrationOpenDate', 'registrationCloseDate',
          'notes', 'isOpen', 'createdBy', 'professorIds',
          'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 20 &&
        data.courseName is string && data.courseName.size() >= 1 && data.courseName.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.examDate is string && data.examDate.size() == 10 && data.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.examTime is string && data.examTime.size() <= 20 &&
        data.classroom is string && data.classroom.size() <= 60 &&
        data.registrationOpenDate is string && data.registrationOpenDate.size() == 10 && data.registrationOpenDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.registrationCloseDate is string && data.registrationCloseDate.size() == 10 && data.registrationCloseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.registrationOpenDate <= data.registrationCloseDate &&
        data.registrationCloseDate <= data.examDate &&
        data.notes is string && data.notes.size() <= 300 &&
        data.isOpen is bool &&
        isValidId(data.createdBy) &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExamRegistration(data) {
      return data.keys().hasAll([
          'termId', 'courseId', 'courseCode', 'courseName',
          'termTitle', 'examDate',
          'studentId', 'studentName', 'studentIndex', 'studentDepartment',
          'status', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'termId', 'courseId', 'courseCode', 'courseName',
          'termTitle', 'examDate',
          'studentId', 'studentName', 'studentIndex', 'studentDepartment',
          'status', 'professorIds', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.termId is string && data.termId.size() >= 1 && data.termId.size() <= 60 && data.termId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 20 &&
        data.courseName is string && data.courseName.size() >= 1 && data.courseName.size() <= 120 &&
        data.termTitle is string && data.termTitle.size() >= 1 && data.termTitle.size() <= 120 &&
        data.examDate is string && data.examDate.size() == 10 && data.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 64 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.studentIndex is string && data.studentIndex.size() <= 20 && data.studentIndex.matches('^[a-zA-Z0-9_\\-]*$') &&
        data.studentDepartment is string && data.studentDepartment.size() >= 1 && data.studentDepartment.size() <= 80 &&
        data.status is string && data.status in ['registered', 'cancelled'] &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll([
          'title', 'body', 'category', 'audience', 'pinned', 'isPublished',
          'authorUid', 'authorName', 'academicYear', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'body', 'category', 'audience', 'pinned', 'isPublished',
          'authorUid', 'authorName', 'academicYear', 'isSeed', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
        data.category is string && data.category in ['opste', 'ispiti', 'nastava', 'semestar'] &&
        data.audience is string && data.audience in ['all', 'students', 'professors'] &&
        data.pinned is bool &&
        data.isPublished is bool &&
        isValidId(data.authorUid) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 20 &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidScheduleEvent(data) {
      return data.keys().hasAll([
          'courseId', 'courseCode', 'courseName', 'eventType', 'title',
          'isRecurringWeekly', 'dayOfWeek', 'date', 'startTime', 'endTime',
          'location', 'description', 'createdBy', 'professorIds', 'isSeed',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'courseCode', 'courseName', 'eventType', 'title',
          'isRecurringWeekly', 'dayOfWeek', 'date', 'startTime', 'endTime',
          'location', 'description', 'createdBy', 'professorIds', 'isSeed',
          'createdAt', 'updatedAt'
        ]) &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 60 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 20 &&
        data.courseName is string && data.courseName.size() >= 1 && data.courseName.size() <= 120 &&
        data.eventType is string && data.eventType in ['lecture', 'lab', 'exam', 'project_deadline'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.isRecurringWeekly is bool &&
        data.dayOfWeek is number && data.dayOfWeek >= 1 && data.dayOfWeek <= 7 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 10 &&
        data.endTime is string && data.endTime.size() <= 10 &&
        data.location is string && data.location.size() <= 80 &&
        data.description is string && data.description.size() <= 300 &&
        isValidId(data.createdBy) &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAcademicState(data) {
      return data.keys().hasAll([
          'activeAcademicYear', 'activeSemesterType', 'semesterLabel',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'activeAcademicYear', 'activeSemesterType', 'semesterLabel',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.activeAcademicYear is string && data.activeAcademicYear.size() >= 1 && data.activeAcademicYear.size() <= 20 &&
        data.activeSemesterType is string && data.activeSemesterType in ['Zimski', 'Ljetni'] &&
        data.semesterLabel is string && data.semesterLabel.size() >= 1 && data.semesterLabel.size() <= 80 &&
        isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidActivityAward(data) {
      return data.keys().hasAll([
          'courseId', 'studentId', 'points', 'maxPoints', 'date',
          'description', 'awardedBy', 'professorIds', 'isSeed',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'courseId', 'studentId', 'points', 'maxPoints', 'date',
          'description', 'awardedBy', 'professorIds', 'isSeed',
          'createdAt', 'updatedAt'
        ]) &&
        isValidCourseId(data.courseId) &&
        isValidStudentId(data.studentId) &&
        data.points is number && data.points >= 0 && data.points <= 100 &&
        data.maxPoints is number && data.maxPoints >= 0 && data.maxPoints <= 100 &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
        isValidId(data.awardedBy) &&
        isValidBoundedIdList(data.professorIds, 1, 10) &&
        data.isSeed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminIndex(data) {
      return data.keys().hasAll([
          'userIds', 'provisionedIds', 'courseIds', 'enrollmentIds',
          'scheduleEventIds', 'announcementIds', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userIds', 'provisionedIds', 'courseIds', 'enrollmentIds',
          'scheduleEventIds', 'announcementIds', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidBoundedIdList(data.userIds, 0, 500) &&
        isValidBoundedIdList(data.provisionedIds, 0, 500) &&
        isValidBoundedIdList(data.courseIds, 0, 200) &&
        isValidBoundedIdList(data.enrollmentIds, 0, 1000) &&
        isValidBoundedIdList(data.scheduleEventIds, 0, 500) &&
        isValidBoundedIdList(data.announcementIds, 0, 200) &&
        isValidId(data.updatedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Match Blocks
    // =========================================================================

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isSignedIn() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().uid == adminId &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isValidAdmin(incoming()) && isSignedIn() && isValidId(adminId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['grantedBy', 'updatedAt']) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(adminId) && isAdmin();
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isProfessorUser() || isAdmin()
      );
      allow list: if isBootstrapAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            (request.auth.token.email == 'sribic@etf.unsa.ba' || request.auth.token.email == 'samir.admin@etf.unsa.ba')
          ) ||
          (
            request.auth.uid == userId &&
            incoming().role == 'student' &&
            incoming().redeemedInviteId == '' &&
            incoming().isSeed == false &&
            (!('provisionedByAdmin' in incoming()) || incoming().provisionedByAdmin == false)
          ) ||
          (
            request.auth.uid == userId &&
            incoming().isSeed == false &&
            isValidId(incoming().redeemedInviteId) &&
            exists(/databases/$(database)/documents/provisionedAccounts/$(incoming().redeemedInviteId)) &&
            get(/databases/$(database)/documents/provisionedAccounts/$(incoming().redeemedInviteId)).data.status in ['pending', 'active', 'claimed'] &&
            get(/databases/$(database)/documents/provisionedAccounts/$(incoming().redeemedInviteId)).data.targetEmail == request.auth.token.email &&
            get(/databases/$(database)/documents/provisionedAccounts/$(incoming().redeemedInviteId)).data.role == incoming().role
          ) ||
          (
            request.auth.uid == userId &&
            incoming().role == 'professor' &&
            incoming().isSeed == false &&
            (!('provisionedByAdmin' in incoming()) || incoming().provisionedByAdmin == false) &&
            isValidId(incoming().redeemedInviteId) &&
            exists(/databases/$(database)/documents/invitations/$(incoming().redeemedInviteId)) &&
            get(/databases/$(database)/documents/invitations/$(incoming().redeemedInviteId)).data.status == 'pending' &&
            get(/databases/$(database)/documents/invitations/$(incoming().redeemedInviteId)).data.targetEmail == request.auth.token.email
          )
        );
      allow update: if isValidUserProfile(incoming()) && isSignedIn() && isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().isSeed == existing().isSeed &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() && (
          (
            request.auth.uid == userId &&
            (request.auth.token.email == 'sribic@etf.unsa.ba' || request.auth.token.email == 'samir.admin@etf.unsa.ba') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'provisionedByAdmin', 'fullName', 'academicTitle', 'officeLocation',
              'consultationHours', 'department', 'academicYear', 'studyYear', 'studyTrack',
              'personalNote', 'notificationPrefs', 'updatedAt'
            ])
          ) ||
          (
            request.auth.uid == userId &&
            existing().role in ['professor', 'admin'] &&
            incoming().role == existing().role &&
            incoming().redeemedInviteId == existing().redeemedInviteId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'studentIndex', 'department', 'academicYear',
              'academicTitle', 'officeLocation', 'consultationHours',
              'studyYear', 'studyTrack',
              'personalNote', 'notificationPrefs', 'updatedAt'
            ])
          ) ||
          (
            request.auth.uid == userId &&
            existing().role == 'student' &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'personalNote', 'notificationPrefs', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'studentIndex', 'department', 'role', 'academicYear', 'redeemedInviteId',
              'academicTitle', 'officeLocation', 'consultationHours', 'studyYear', 'studyTrack',
              'personalNote', 'provisionedByAdmin', 'notificationPrefs', 'updatedAt'
            ])
          ) ||
          (
            request.auth.uid == userId &&
            existing().role == 'student' &&
            incoming().role == 'professor' &&
            isValidId(incoming().redeemedInviteId) &&
            exists(/databases/$(database)/documents/invitations/$(incoming().redeemedInviteId)) &&
            get(/databases/$(database)/documents/invitations/$(incoming().redeemedInviteId)).data.status == 'pending' &&
            get(/databases/$(database)/documents/invitations/$(incoming().redeemedInviteId)).data.targetEmail == request.auth.token.email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'redeemedInviteId', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    match /userPrivate/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isValidUserPrivate(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isVerified() && request.auth.uid == userId && incoming().email == request.auth.token.email)
        );
      allow update: if isValidUserPrivate(incoming()) && isSignedIn() && isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() && (
          (
            request.auth.uid == userId &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'updatedAt'])
          ) ||
          (
            isVerified() &&
            request.auth.uid == userId &&
            incoming().email == request.auth.token.email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt'])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    match /provisionedAccounts/{provId} {
      allow get: if isSignedIn() && isValidId(provId) && (
        isAdmin() ||
        (isVerified() && (resource == null || resource.data.targetEmail == request.auth.token.email))
      );
      allow list: if isBootstrapAdmin();
      allow create: if isSignedIn() && isValidId(provId) && isValidProvisionedAccount(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isValidProvisionedAccount(incoming()) && isSignedIn() && isValidId(provId) &&
        incoming().targetEmail == existing().targetEmail &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'role', 'studentIndex', 'department', 'studyTrack', 'studyYear',
              'academicYear', 'academicTitle', 'officeLocation', 'consultationHours',
              'authUid', 'status', 'updatedAt'
            ])
          ) ||
          (
            isVerified() &&
            existing().status in ['pending', 'active'] &&
            incoming().status == 'claimed' &&
            request.auth.token.email == existing().targetEmail &&
            incoming().authUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'authUid', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(provId) && isAdmin();
    }

    match /studentDirectory/{studentIndex} {
      allow get: if isSignedIn() && isValidId(studentIndex) && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        isProfessorUser() ||
        isAdmin()
      );
      allow list: if isBootstrapAdmin();
      allow create: if isSignedIn() && isValidId(studentIndex) && isValidStudentDirectory(incoming()) &&
        incoming().studentIndex == studentIndex &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() && (
          isAdmin() ||
          (
            isVerified() &&
            incoming().uid == request.auth.uid &&
            incoming().isSeed == false &&
            exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.studentIndex == studentIndex
          )
        );
      allow update: if isValidStudentDirectory(incoming()) && isSignedIn() && isValidId(studentIndex) &&
        incoming().studentIndex == existing().studentIndex &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().isSeed == existing().isSeed &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'department', 'updatedAt']) &&
        isAuthorizedUser() &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(studentIndex) && isAdmin();
    }

    match /invitations/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        isAdmin() || (isVerified() && resource != null && resource.data.targetEmail == request.auth.token.email)
      );
      allow list: if isBootstrapAdmin();
      allow create: if isSignedIn() && isValidId(inviteId) && isValidInvitation(incoming()) &&
        incoming().code == inviteId &&
        incoming().status == 'pending' &&
        incoming().acceptedBy == '' &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isValidInvitation(incoming()) && isSignedIn() && isValidId(inviteId) &&
        incoming().code == existing().code &&
        incoming().targetEmail == existing().targetEmail &&
        incoming().role == existing().role &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() &&
        (existing().status == 'pending' || isAdmin()) && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedBy', 'updatedAt'])
          ) ||
          (
            isVerified() &&
            existing().status == 'pending' &&
            incoming().status == 'accepted' &&
            request.auth.token.email == existing().targetEmail &&
            incoming().acceptedBy == request.auth.uid &&
            getAfter(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'professor' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedBy', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(inviteId) && isAdmin();
    }

    match /courses/{courseId} {
      allow get: if isSignedIn() && isValidId(courseId) && (
        (resource != null && (
          resource.data.leadProfessorId == request.auth.uid ||
          request.auth.uid in resource.data.professorIds
        )) ||
        isEnrolledStudent(courseId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.leadProfessorId == request.auth.uid ||
        request.auth.uid in resource.data.professorIds ||
        isBootstrapAdmin()
      );
      allow create: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() && (
          (
            isProfessorUser() &&
            incoming().leadProfessorId == request.auth.uid &&
            request.auth.uid in incoming().professorIds &&
            incoming().isSeed == false
          ) ||
          isAdmin()
        );
      allow update: if isValidCourse(incoming()) && isSignedIn() && isValidId(courseId) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().isSeed == existing().isSeed &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() &&
        (
          existing().leadProfessorId == request.auth.uid ||
          request.auth.uid in existing().professorIds ||
          isProfessorUser() ||
          isAdmin()
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'semester', 'academicYear', 'ects',
          'leadProfessorId', 'leadProfessorName', 'professorIds',
          'professorNames', 'assistantNames', 'studyProgram',
          'categoryIds', 'itemIds', 'sessionIds', 'examTermIds', 'scheduleEventIds',
          'isArchived',
          'attendanceEnabled', 'attendanceMaxPoints', 'allowBonusPoints', 'activityMarksEnabled',
          'grade6Threshold', 'grade7Threshold', 'grade8Threshold', 'grade9Threshold', 'grade10Threshold',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(courseId) && isAuthorizedUser() && (
        (resource != null && resource.data.leadProfessorId == request.auth.uid) || isAdmin()
      );
    }

    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && isValidId(enrollmentId) && (
        (resource != null && (
          resource.data.studentId == request.auth.uid ||
          request.auth.uid in resource.data.professorIds ||
          isCourseProfessor(resource.data.courseId)
        )) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        request.auth.uid in resource.data.professorIds ||
        isBootstrapAdmin()
      );
      allow create: if isSignedIn() && isValidId(enrollmentId) && isValidEnrollment(incoming()) &&
        enrollmentId == incoming().courseId + '_' + incoming().studentId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedUser() &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId)) &&
        (isCourseProfessor(incoming().courseId) || isAdmin());
      allow update: if isValidEnrollment(incoming()) && isSignedIn() && isValidId(enrollmentId) &&
        incoming().courseId == existing().courseId &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().isSeed == existing().isSeed &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'courseCode', 'courseName', 'leadProfessorName', 'academicYear',
          'semester', 'isArchived',
          'studentName', 'studentIndex', 'studentDepartment', 'professorIds', 'updatedAt'
        ]) &&
        isAuthorizedUser() &&
        (isCourseProfessor(existing().courseId) || isAdmin());
      allow delete: if isSignedIn() && isValidId(enrollmentId) && isAuthorizedUser() && (
        (resource != null && (
          request.auth.uid in resource.data.professorIds ||
          isCourseProfessor(resource.data.courseId)
        )) ||
        isAdmin()
