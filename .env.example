# APP_URL: Javna URL adresa aplikacije u produkciji ili razvojnom okruženju
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Opcioni serverski ključ okruženja
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Konfiguracija baze podataka i autentifikacije (Firebase / Firestore)
# Generiše se automatski u firebase-applet-config.json prilikom povezivanja projekta.
VITE_ACADEMIC_YEAR="2026/2027"
